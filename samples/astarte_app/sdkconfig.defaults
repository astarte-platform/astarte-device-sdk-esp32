# Configuration to use our custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition_table.csv"
CONFIG_PARTITION_TABLE_CUSTOM_APP_BIN_OFFSET=0x10000
CONFIG_PARTITION_TABLE_FILENAME="partition_table.csv"
CONFIG_APP_OFFSET=0x10000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Astarte device configuration
CONFIG_ASTARTE_DEVICE_SDK_HOSTNAME="......................"
CONFIG_ASTARTE_DEVICE_SDK_REALM_NAME="......................"
# Enable for registration through JWT
# CONFIG_ASTARTE_DEVICE_SDK_PAIRING_JWT="."
CONFIG_ASTARTE_DEVICE_SDK_NVS=y
CONFIG_ASTARTE_DEVICE_SDK_NVS_PARTITION_LABEL="astarte"

# Astarte sample configuration
CONFIG_WIFI_SSID="......................"
CONFIG_WIFI_PASSWORD="......................"
CONFIG_DEVICE_ID="......................"
# Enable for manual registration
# CONFIG_CREDENTIAL_SECRET="."
CONFIG_DEVICE_REGISTRATION=n
CONFIG_DEVICE_INDIVIDUAL_TRANSMISSION=n
CONFIG_DEVICE_OBJECT_TRANSMISSION=n
CONFIG_DEVICE_PROPERTY_SET_TRANSMISSION=n
CONFIG_DEVICE_PROPERTY_UNSET_TRANSMISSION=n
